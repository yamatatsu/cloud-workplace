# --- Secrets (generate and persist; do not rotate on rebuild) ---
# JWT_SECRET: openssl rand -hex 32
JWT_SECRET=
# JWT_REFRESH_SECRET: openssl rand -hex 32
JWT_REFRESH_SECRET=
# CREDS_KEY:  openssl rand -hex 32
CREDS_KEY=
# CREDS_IV:   openssl rand -hex 16
CREDS_IV=

# --- Registration ---
# Keep true for first boot to create the admin account, then set false.
ALLOW_REGISTRATION=true

# --- Conversation search (Meilisearch) ---
# Not used in this setup; enable only if Meilisearch is added.
SEARCH=false

# Web search (Tavily powers both search provider and scraper).
TAVILY_API_KEY=

# --- Fireworks ---
FIREWORKS_API_KEY=
